# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# Anthropic Claude API key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project URL and service role key (server-side only)
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key and webhook secret (server-side only)
# Get from: Stripe dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Supabase public keys (safe to expose in frontend — VITE_ prefix required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
